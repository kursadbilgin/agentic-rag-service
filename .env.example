# =============================================================================
# Agentic RAG Service — configuration contract
# Copy this file to .env and fill in your values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider
# Which chat-model provider to use. Supported: "anthropic" | "google"
# -----------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# Anthropic (Claude)
# Required when LLM_PROVIDER=anthropic
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model name; see https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_MODEL=claude-opus-4-8

# -----------------------------------------------------------------------------
# Google Generative AI (Gemini)
# Required when LLM_PROVIDER=google
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=
# Model name; see https://ai.google.dev/gemini-api/docs/models
GOOGLE_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# PostgreSQL + pgvector
# Start the DB locally: docker compose up -d postgres
# Default credentials match docker-compose.yml (dev-only)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# Table name used for the vector collection
VECTOR_COLLECTION=rag_docs

# -----------------------------------------------------------------------------
# Retrieval settings
# -----------------------------------------------------------------------------
# Number of document chunks returned per similarity search
RETRIEVAL_TOP_K=4

# Maximum number of query-rewrite attempts before the agent gives up
# (0 = no rewrites; agent returns "not found" on first irrelevant result)
MAX_QUERY_REWRITES=1

# -----------------------------------------------------------------------------
# Embedding model (FastEmbed / ONNX — no API key required)
# Name must be a model supported by the fastembed library
# Multilingual model chosen to support Turkish demo queries (e.g. "İade ne kadar sürede yapılır?")
# sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2: ~50 languages, 384-dim, fast
# -----------------------------------------------------------------------------
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
